{
  "name": "cyclosa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "從一個「點」出發，用 LLM 主動擴展成一張每條關聯都帶出處的網。純本機，資料存在專案外的資料根目錄。",
  "license": "MIT",
  "engines": {
    "node": ">=24.20 <25"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "tsx watch src/main.ts",
    "build": "npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.build.json && node tools/build/copy-assets.mjs",
    "build:web": "vite build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && vue-tsc -p tsconfig.web.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix && prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@local-app/lifecycle": "file:vendor/local-app-lifecycle-0.3.0.tgz",
    "@mozilla/readability": "^0.6.0",
    "3d-force-graph": "^1.80.1",
    "d3-force-3d": "^3.0.6",
    "fastify": "^5.12.7",
    "franc": "^6.2.0",
    "linkedom": "^0.18.14",
    "pdfjs-dist": "^6.4.299",
    "pinia": "^4.1.0",
    "three": "^0.186.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-vue": "^6.0.10",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13"
  }
}
